    "test:browser": "playwright test",
    "test:collection": "playwright test --config playwright.collection.config.ts"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "@types/node": "24.10.0"
  }
}
